        local OptionHolder = Instance.new("Frame")
        OptionHolder.Size = UDim2.new(1, -16, 0, 0)
        OptionHolder.Position = UDim2.new(0, 8, 0, 32)
        OptionHolder.BackgroundTransparency = 1
        OptionHolder.Parent = DropFrame

        local OptionLayout = Instance.new("UIListLayout")
        OptionLayout.Padding = UDim.new(0, 4)
        OptionLayout.Parent = OptionHolder

        local isExpanded = false

        local function RefreshSize()
            if isExpanded then
                local contentHeight = OptionLayout.AbsoluteContentSize.Y + 40
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, contentHeight)}):Play()
            else
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 32)}):Play()
            end
        end

        DropHeader.MouseButton1Click:Connect(function()
            isExpanded = not isExpanded
            SelectedLbl.Text = defaultOpt .. (isExpanded and " ^" or " v")
            RefreshSize()
        end)

        local function PopulateOptions(list)
            for _, child in pairs(OptionHolder:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end

            for _, opt in ipairs(list) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, 0, 0, 26)
                OptBtn.BackgroundColor3 = currentTheme.MainBg
                OptBtn.Text = opt
                OptBtn.TextColor3 = currentTheme.TextSub
                OptBtn.Font = Enum.Font.Gotham
                OptBtn.TextSize = 11
                OptBtn.Parent = OptionHolder

                local OptCorner = Instance.new("UICorner")
                OptCorner.CornerRadius = UDim.new(0, 4)
                OptCorner.Parent = OptBtn

                OptBtn.MouseButton1Click:Connect(function()
                    defaultOpt = opt
                    SelectedLbl.Text = opt .. " v"
                    isExpanded = false
                    RefreshSize()

                    if autoNotif then
                        Window:Notification({
                            Title = dropName,
                            Description = "Selected: " .. opt,
                            Duration = 2
                        })
                    end

                    pcall(callback, opt)
                end)
            end
        end

        PopulateOptions(options)

        return {
            Refresh = function(_, newList)
                options = newList
                PopulateOptions(newList)
            end
        }
    end

    return Window
end

return Hibatzzz
