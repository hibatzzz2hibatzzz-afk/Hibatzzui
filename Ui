        PageListLayout.Parent = TabPage

        PageListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabPage.CanvasSize = UDim2.new(0, 0, 0, PageListLayout.AbsoluteContentSize.Y + 10)
        end)

        local function SelectTab()
            for _, t in pairs(Window.Tabs) do
                t.Page.Visible = false
                TweenService:Create(t.Button, TweenInfo.new(0.15), { BackgroundColor3 = currentTheme.CardBg }):Play()
                t.Text.TextColor3 = currentTheme.TextSub
            end
            TabPage.Visible = true
            TweenService:Create(TabButton, TweenInfo.new(0.15), { BackgroundColor3 = currentTheme.Stroke }):Play()
            TabTitle.TextColor3 = currentTheme.Text
        end

        TabButton.MouseButton1Click:Connect(SelectTab)
        table.insert(Window.Tabs, {Button = TabButton, Text = TabTitle, Page = TabPage})

        if #Window.Tabs == 1 then SelectTab() end

        Tab.Page = TabPage
        Window.CreatedTabs[tabName] = Tab
        return Tab
    end

    function Window:AddFeature(config)
        local featureName = config.Feature or "Unnamed Feature"
        local targetTabName = config.Tab or "Main"
        local isLoop = string.lower(tostring(config.loop or config.Loop or "no")) == "yes"
        local autoNotif = string.lower(tostring(config["Auto Notif"] or config.AutoNotif or "no")) == "yes"
        local systemCallback = config["System Feature"] or function() end

        local TabObj = Window:CreateTab(targetTabName)

        local Button = Instance.new("TextButton")
        Button.Size = UDim2.new(1, 0, 0, 32)
        Button.BackgroundColor3 = currentTheme.CardBg
        Button.Text = isLoop and (featureName .. " [OFF]") or featureName
        Button.TextColor3 = currentTheme.TextSub
        Button.Font = Enum.Font.GothamMedium
        Button.TextSize = 12
        Button.AutoButtonColor = false
        Button.Parent = TabObj.Page

        local BtnCorner = Instance.new("UICorner")
        BtnCorner.CornerRadius = UDim.new(0, 6)
        BtnCorner.Parent = Button

        local BtnStroke = Instance.new("UIStroke")
        BtnStroke.Color = currentTheme.Stroke
        BtnStroke.Thickness = 1
        BtnStroke.Parent = Button

        if not isLoop then
            Button.MouseButton1Click:Connect(function()
                TweenService:Create(Button, TweenInfo.new(0.1), {BackgroundColor3 = currentTheme.Stroke}):Play()
                task.delay(0.15, function()
                    TweenService:Create(Button, TweenInfo.new(0.1), {BackgroundColor3 = currentTheme.CardBg}):Play()
                end)

                if autoNotif then
                    Window:Notification({
                        Title = featureName,
                        Description = featureName .. " Executed!",
                        Duration = 2
                    })
                end

                pcall(systemCallback)
            end)
        else
            local toggled = false
            Button.MouseButton1Click:Connect(function()
                toggled = not toggled

                if toggled then
                    Button.Text = featureName .. " [ON]"
                    Button.TextColor3 = currentTheme.Text
                    TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = currentTheme.Accent}):Play()
                    BtnStroke.Color = currentTheme.AccentActive

                    if autoNotif then
                        Window:Notification({
                            Title = featureName,
                            Description = featureName .. " ON",
                            Duration = 2
                        })
                    end
                else
                    Button.Text = featureName .. " [OFF]"
                    Button.TextColor3 = currentTheme.TextSub
                    TweenService:Create(Button, TweenInfo.new(0.15), {BackgroundColor3 = currentTheme.CardBg}):Play()
                    BtnStroke.Color = currentTheme.Stroke

                    if autoNotif then
                        Window:Notification({
                            Title = featureName,
                            Description = featureName .. " OFF",
                            Duration = 2
                        })
                    end
                end

                pcall(systemCallback, toggled)
            end)
        end
    end

